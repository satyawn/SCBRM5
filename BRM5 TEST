-- [ SETTINGS ]
------------------------------------------------------------------
local hitboxSize = 20
local activeNPCs = {}
local originalSizes = {}

local wallEnabled = false
local outlineEnabled = false
local fastScanEnabled = false
local fullBrightEnabled = false
local alwaysDayEnabled = false

-- HITBOX MODE
local hitboxHeadEnabled = false
local hitboxBodyEnabled = false

-- AIM
local silentAimEnabled = false
local fovRadius = 180

------------------------------------------------------------------
-- 🧠 NPC SYSTEM
------------------------------------------------------------------
local function isValidNPC(model)
    if not model or not model.Parent then return false end
    local name = model.Name:lower()
    return name:find("zombie") or model:FindFirstChild("AI_")
end

local function addNPC(model)
    if activeNPCs[model] then return end

    local head = model:FindFirstChild("Head")
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")

    if root then
        activeNPCs[model] = {
            head = head or root,
            root = root
        }
    end
end

------------------------------------------------------------------
-- 🔍 SCAN
------------------------------------------------------------------
local lastScan = 0
local function scanNPCs()
    if not fastScanEnabled then return end
    if tick() - lastScan < 0.5 then return end
    lastScan = tick()

    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isValidNPC(m) then
            addNPC(m)
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") then
        task.delay(0.2, function()
            if isValidNPC(obj) then addNPC(obj) end
        end)
    end
end)

------------------------------------------------------------------
-- 🎯 HITBOX SYSTEM
------------------------------------------------------------------
local function updateHitbox()
    for model, data in pairs(activeNPCs) do
        if not model.Parent then
            activeNPCs[model] = nil
        else
            local head = model:FindFirstChild("Head")
            local root = data.root

            -- HEAD HITBOX
            if hitboxHeadEnabled and head then
                if not originalSizes[model] then
                    originalSizes[model] = {head = head.Size}
                end
                head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            end

            -- BODY HITBOX
            if hitboxBodyEnabled and root then
                if not originalSizes[model] then
                    originalSizes[model] = {root = root.Size}
                end
                root.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            end

            -- RESTORE
            if not hitboxHeadEnabled and not hitboxBodyEnabled then
                if originalSizes[model] then
                    if head and originalSizes[model].head then
                        head.Size = originalSizes[model].head
                    end
                    if root and originalSizes[model].root then
                        root.Size = originalSizes[model].root
                    end
                    originalSizes[model] = nil
                end
            end
        end
    end
end

------------------------------------------------------------------
-- 👁️ ESP
------------------------------------------------------------------
local function updateESP()
    for model, data in pairs(activeNPCs) do
        if not model.Parent then continue end

        if outlineEnabled then
            if not model:FindFirstChild("ESP_Outline") then
                local h = Instance.new("Highlight")
                h.Name = "ESP_Outline"
                h.FillTransparency = 1
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = model
            end
        else
            local h = model:FindFirstChild("ESP_Outline")
            if h then h:Destroy() end
        end

        if wallEnabled then
            local part = data.head
            if part and not part:FindFirstChild("Wall_Box") then
                local s = Instance.new("SphereHandleAdornment")
                s.Name = "Wall_Box"
                s.Radius = 1.2
                s.Adornee = part
                s.AlwaysOnTop = true
                s.Transparency = 0.3
                s.Parent = part
            end
        else
            local part = data.head
            if part and part:FindFirstChild("Wall_Box") then
                part.Wall_Box:Destroy()
            end
        end
    end
end

