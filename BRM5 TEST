-- [[ TOKAI HUB - FINAL (HEAD HITBOX + AUTO CLEAN) ]]

------------------------------------------------------------------
-- 🔥 AUTO CLOSE OLD SCRIPT
------------------------------------------------------------------
if getgenv().TOKAI_UNLOAD then
    pcall(getgenv().TOKAI_UNLOAD)
end

getgenv().TOKAI_UNLOAD = function()
    _G.TOKAI_RUNNING = false
end

_G.TOKAI_RUNNING = true

------------------------------------------------------------------
-- [ SERVICES ]
------------------------------------------------------------------
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local lighting = game:GetService("Lighting")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera

------------------------------------------------------------------
-- [ SETTINGS ]
------------------------------------------------------------------
local hitboxSize = 20
local activeNPCs = {}
local originalSizes = {}

local wallEnabled = false
local outlineEnabled = false
local silentEnabled = false
local fastScanEnabled = false
local fullBrightEnabled = false
local alwaysDayEnabled = false

-- SILENT AIM
local fovRadius = 180

------------------------------------------------------------------
-- ✅ NPC SYSTEM
------------------------------------------------------------------
local function isValidNPC(model)
    if not model or not model.Parent then return false end
    local name = model.Name:lower()
    return name:find("zombie") or model:FindFirstChild("AI_")
end

local function addNPC(model)
    if activeNPCs[model] then return end

    local head = model:FindFirstChild("Head")
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")

    if root then
        activeNPCs[model] = {
            head = head or root,
            root = root
        }
    end
end

------------------------------------------------------------------
-- ✅ SMART SCAN
------------------------------------------------------------------
local lastScan = 0
local function scanNPCs()
    if not fastScanEnabled then return end
    if tick() - lastScan < 0.5 then return end
    lastScan = tick()

    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isValidNPC(m) then
            addNPC(m)
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") then
        task.delay(0.2, function()
            if isValidNPC(obj) then
                addNPC(obj)
            end
        end)
    end
end)

------------------------------------------------------------------
-- 🎯 HEAD HITBOX
------------------------------------------------------------------
local function updateHitbox()
    for model, data in pairs(activeNPCs) do
        if not model.Parent then
            activeNPCs[model] = nil
        else
            local head = model:FindFirstChild("Head")

            if head then
                if silentEnabled then
                    local size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)

                    if not originalSizes[model] then
                        originalSizes[model] = head.Size
                    end

                    if head.Size ~= size then
                        head.Size = size
                    end

                    head.CanCollide = false
                else
                    if originalSizes[model] then
                        head.Size = originalSizes[model]
                        originalSizes[model] = nil
                    end
                end
            end
        end
    end
end

------------------------------------------------------------------
-- 👁️ ESP SYSTEM
------------------------------------------------------------------
local function updateESP()
    for model, data in pairs(activeNPCs) do
        if not model.Parent then continue end

        -- OUTLINE
        if outlineEnabled then
            if not model:FindFirstChild("ESP_Outline") then
                local h = Instance.new("Highlight")
                h.Name = "ESP_Outline"
                h.FillTransparency = 1
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = model
            end
        else
            local h = model:FindFirstChild("ESP_Outline")
            if h then h:Destroy() end
        end

        -- SPHERE
        if wallEnabled then
            local part = data.head
            if part and not part:FindFirstChild("Wall_Box") then
                local s = Instance.new("SphereHandleAdornment")
                s.Name = "Wall_Box"
                s.Radius = 1.2
                s.Adornee = part
                s.AlwaysOnTop = true
                s.Transparency = 0.3
                s.Parent = part
            end
        else
            local part = data.head
            if part and part:FindFirstChild("Wall_Box") then
                part.Wall_Box:Destroy()
            end
        end
    end
end

------------------------------------------------------------------
-- 💡 LIGHTING
------------------------------------------------------------------
local function updateLighting()
    if fullBrightEnabled then
        lighting.Brightness = 2
        lighting.Ambient = Color3.new(1,1,1)
    end
    if alwaysDayEnabled then
        lighting.ClockTime = 12
    end
end

------------------------------------------------------------------
-- 🔄 MAIN LOOP (SAFE)
------------------------------------------------------------------
local lastESP = 0
local lastHitbox = 0

local hbConnection
hbConnection = RunService.Heartbeat:Connect(function()
    if not _G.TOKAI_RUNNING then
        hbConnection:Disconnect()
        return
    end

    scanNPCs()

    if tick() - lastHitbox > 0.1 then
        lastHitbox = tick()
        updateHitbox()
    end

    if tick() - lastESP > 0.3 then
        lastESP = tick()
        updateESP()
    end

    updateLighting()
end)

------------------------------------------------------------------
-- 🚀 INIT
------------------------------------------------------------------
for _, m in ipairs(Workspace:GetDescendants()) do
    if m:IsA("Model") and isValidNPC(m) then
        addNPC(m)
    end
end

print("Tokai Hub FINAL (HEAD HITBOX + AUTO CLEAN) Loaded 🚀")
