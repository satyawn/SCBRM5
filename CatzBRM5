-- LOOPS
---------------------------------------------------------------------
-- SCAN
task.spawn(function()
    while true do
        if Settings.FastScan then
            for _,m in ipairs(Services.Workspace:GetDescendants()) do
                if m:IsA("Model") then
                    AddNPC(m)
                end
            end
        end
        task.wait(0.001)
    end
end)

-- HITBOX
task.spawn(function()
    while true do
        if Settings.SilentHitbox then
            for m,d in pairs(NPCs) do
                if m.Parent then
                    ApplyHitbox(m,d.root)
                end
            end
        else
            for m in pairs(OriginalSizes) do
                RestoreHitbox(m)
            end
        end
        task.wait(0.1)
    end
end)

-- RENDER
Services.Run.RenderStepped:Connect(function()
    local center = GetCenter()

    if FOVCircle then
        FOVCircle.Visible = Settings.ShowFOV and Settings.SilentAim
        FOVCircle.Position = center
        FOVCircle.Radius = Settings.FOV
    end

    if Settings.FullBright then
        Services.Lighting.Brightness = 2
        Services.Lighting.Ambient = Color3.new(1,1,1)
    end

    if Settings.AlwaysDay then
        Services.Lighting.ClockTime = 12
    end
end)

