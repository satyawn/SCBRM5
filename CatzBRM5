-- [[ TOKAI HUB - OPTIMIZED FULL FEATURE ]]

-- [ SERVICES ]
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- [ SETTINGS ]
local hitboxSize = 20
local activeNPCs = {}
local trackedParts = {}
local originalSizes = {}

local wallEnabled = false
local outlineEnabled = false
local silentEnabled = false
local fastScanEnabled = false
local fullBrightEnabled = false
local alwaysDayEnabled = false

-- SILENT AIM
local silentAimEnabled = false
local fovRadius = 180
local showFovCircle = true

------------------------------------------------------------------
-- ✅ SAFE CACHE SYSTEM
------------------------------------------------------------------
local function isValidNPC(model)
    if not model or not model.Parent then return false end
    local name = model.Name:lower()
    return name:find("zombie") or model:FindFirstChild("AI_")
end

local function addNPC(model)
    if activeNPCs[model] then return end

    local head = model:FindFirstChild("Head")
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")

    if root then
        activeNPCs[model] = {
            head = head or root,
            root = root
        }
    end
end

------------------------------------------------------------------
-- ✅ SMART SCAN (NO LAG)
------------------------------------------------------------------
local lastScan = 0
local function scanNPCs()
    if not fastScanEnabled then return end
    if tick() - lastScan < 0.5 then return end
    lastScan = tick()

    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isValidNPC(m) then
            addNPC(m)
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") then
        task.delay(0.2, function()
            if isValidNPC(obj) then
                addNPC(obj)
            end
        end)
    end
end)

------------------------------------------------------------------
-- ✅ HITBOX (OPTIMIZED)
------------------------------------------------------------------
local function updateHitbox()
    for model, data in pairs(activeNPCs) do
        if not model.Parent then
            activeNPCs[model] = nil
        else
            local root = data.root
            if silentEnabled then
                local size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)

                if root.Size ~= size then
                    if not originalSizes[model] then
                        originalSizes[model] = root.Size
                    end
                    root.Size = size
                end
            else
                if originalSizes[model] then
                    root.Size = originalSizes[model]
                    originalSizes[model] = nil
                end
            end
        end
    end
end

------------------------------------------------------------------
-- ✅ ESP (NO RECREATE SPAM)
------------------------------------------------------------------
local function updateESP()
    for model, data in pairs(activeNPCs) do
        if not model.Parent then continue end

        -- OUTLINE
        if outlineEnabled then
            if not model:FindFirstChild("ESP_Outline") then
                local h = Instance.new("Highlight")
                h.Name = "ESP_Outline"
                h.FillTransparency = 1
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = model
            end
        else
            local h = model:FindFirstChild("ESP_Outline")
            if h then h:Destroy() end
        end

        -- SPHERE
        if wallEnabled then
            local part = data.head
            if part and not part:FindFirstChild("Wall_Box") then
                local s = Instance.new("SphereHandleAdornment")
                s.Name = "Wall_Box"
                s.Radius = 1.2
                s.Adornee = part
                s.AlwaysOnTop = true
                s.Transparency = 0.3
                s.Parent = part
            end
        else
            local part = data.head
            if part and part:FindFirstChild("Wall_Box") then
                part.Wall_Box:Destroy()
            end
        end
    end
end

------------------------------------------------------------------
-- ✅ SILENT AIM (UNCHANGED LOGIC, SAFE)
------------------------------------------------------------------
local function getClosestNPC()
    local closest, dist = nil, fovRadius

    for model, data in pairs(activeNPCs) do
        if model.Parent then
            local pos, visible = camera:WorldToViewportPoint(data.head.Position)
            if visible then
                local d = (Vector2.new(pos.X, pos.Y) - camera.ViewportSize/2).Magnitude
                if d < dist then
                    closest = model
                    dist = d
                end
            end
        end
    end

    return closest
end

------------------------------------------------------------------
-- ✅ LIGHTING
------------------------------------------------------------------
local function updateLighting()
    if fullBrightEnabled then
        lighting.Brightness = 2
        lighting.Ambient = Color3.new(1,1,1)
    end
    if alwaysDayEnabled then
        lighting.ClockTime = 12
    end
end

------------------------------------------------------------------
-- ✅ MAIN LOOP (SMOOTH ENGINE)
------------------------------------------------------------------
local lastESP = 0
local lastHitbox = 0

RunService.Heartbeat:Connect(function()
    scanNPCs()

    if tick() - lastHitbox > 0.1 then
        lastHitbox = tick()
        updateHitbox()
    end

    if tick() - lastESP > 0.3 then
        lastESP = tick()
        updateESP()
    end

    updateLighting()
end)

------------------------------------------------------------------
-- ✅ INIT
------------------------------------------------------------------
for _, m in ipairs(Workspace:GetDescendants()) do
    if m:IsA("Model") and isValidNPC(m) then
        addNPC(m)
    end
end

print("Tokai Hub FULL OPTIMIZED Loaded 🚀")
