---------------------------------------------------------------------
-- UTIL
---------------------------------------------------------------------
local function GetCenter()
    return Camera.ViewportSize / 2
end

local function IsZombie(name)
    return string.find(name:lower(), "zombie")
end

local function IsValidNPC(model)
    if not model or not model.Parent then return false end

    if IsZombie(model.Name) then return true end

    if model.Name == "Male" then
        for _,v in ipairs(model:GetChildren()) do
            if v.Name:sub(1,3) == "AI_" then
                return true
            end
        end
    end
end

---------------------------------------------------------------------
-- VISIBILITY
---------------------------------------------------------------------
local function IsVisible(model)
    if not model:FindFirstChild("Head") then return false end

    local parts = Camera:GetPartsObscuringTarget(
        {model.Head.Position},
        {LP.Character, model}
    )

    return #parts == 0
end

local function GetClosestNPC()
    local closest, dist = nil, Settings.FOV
    local center = GetCenter()

    for model,data in pairs(NPCs) do
        if model.Parent and data.head then
            local pos, visible = Camera:WorldToViewportPoint(data.head.Position)

            if visible then
                local mag = (Vector2.new(pos.X,pos.Y) - center).Magnitude

                if mag < dist and IsVisible(model) then
                    closest = model
                    dist = mag
                end
            end
        end
    end

    return closest
end

---------------------------------------------------------------------
-- HITBOX
---------------------------------------------------------------------
local function ApplyHitbox(model, root)
    if not OriginalSizes[model] then
        OriginalSizes[model] = root.Size
    end

    root.Size = Vector3.new(Settings.HitboxSize,Settings.HitboxSize,Settings.HitboxSize)
    root.Transparency = Settings.ShowHitbox and 0.8 or 1

    if Settings.ShowHitbox then
        root.Color = Colors.Hitbox
        root.Material = Enum.Material.Neon
    end
end

local function RestoreHitbox(model)
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")

    if root and OriginalSizes[model] then
        root.Size = OriginalSizes[model]
        root.Transparency = 1
        OriginalSizes[model] = nil
    end
end

---------------------------------------------------------------------
-- ESP
---------------------------------------------------------------------
local function CreateSphere(part, model)
    if part:FindFirstChild("Wall_Box") then return end

    local s = Instance.new("SphereHandleAdornment")
    s.Name = "Wall_Box"
    s.Radius = 1.2
    s.Adornee = part
    s.AlwaysOnTop = true
    s.Transparency = 0.3

    s.Color3 = IsZombie(model.Name) and Colors.Zombie or Colors.Male
    s.Parent = part

    TrackedParts[part] = true
end

local function ApplyOutline(model)
    local h = model:FindFirstChild("ESP_Outline")

    if Settings.ESP_Outline and IsValidNPC(model) then
        if not h then
            h = Instance.new("Highlight")
            h.Name = "ESP_Outline"
            h.Parent = model
        end

        h.FillTransparency = 1
        h.OutlineColor = IsZombie(model.Name) and Colors.Zombie or Colors.Male
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    elseif h then
        h:Destroy()
    end
end

---------------------------------------------------------------------
-- NPC REGISTER
---------------------------------------------------------------------
local function AddNPC(model)
    if NPCs[model] or not IsValidNPC(model) then return end

    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")
    local head = model:FindFirstChild("Head") or root

    if root then
        NPCs[model] = {root = root, head = head}

        if Settings.ESP_Sphere then
            CreateSphere(head, model)
        end

        ApplyOutline(model)
    end
end

---------------------------------------------------------------------
-- WEAPON PATCH
---------------------------------------------------------------------
local function PatchWeapons()
    pcall(function()
        local folder = Services.RS:FindFirstChild("Shared")
        folder = folder and folder:FindFirstChild("Configs")
        folder = folder and folder:FindFirstChild("Weapon")
        folder = folder and folder:FindFirstChild("Weapons_Player")

        if not folder then return end

        for _,platform in pairs(folder:GetChildren()) do
            if platform.Name:match("^Platform_") then
                for _,weapon in pairs(platform:GetChildren()) do
                    for _,mod in pairs(weapon:GetChildren()) do
                        if mod:IsA("ModuleScript") and mod.Name:match("^Receiver") then
                            task.spawn(function()
                                local ok, data = pcall(require, mod)
                                if ok and data.Config then
                                    local tune = data.Config.Tune

                                    if Settings.WeaponMods.NoRecoil then
                                        tune.Recoil_X = 0
                                        tune.Recoil_Z = 0
                                        tune.RecoilForce_Tap = 0
                                    end

                                    if Settings.WeaponMods.Firemodes then
                                        tune.Firemodes = {3,2,1,0}
                                    end
                                end
                            end)
                        end
                    end
                end
            end
        end
    end)
end

---------------------------------------------------------------------
-- HOOK
---------------------------------------------------------------------
task.spawn(function()
    pcall(function()
        local muzzle = filtergc('function',{Name='GetMuzzleCFrame'},true)

        if muzzle then
            local old
            old = hookfunction(muzzle,function(self,cast)
                local origin,barrel,cf = old(self,cast)

                if Settings.SilentAim and not cast then
                    local npc = GetClosestNPC()
                    if npc and npc:FindFirstChild("Head") then
                        return CFrame.new(origin.Position,npc.Head.Position),barrel,cf
                    end
                end

                return origin,barrel,cf
            end)
        end
    end)
end)

