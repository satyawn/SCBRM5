---------------------------------------------------------------------
-- SETTINGS
---------------------------------------------------------------------
local Settings = {
    HitboxSize = 20,
    FOV = 180,

    SilentAim = false,
    SilentHitbox = false,

    ShowHitbox = false,
    ShowFOV = true,

    ESP_Sphere = false,
    ESP_Outline = false,

    FullBright = false,
    AlwaysDay = false,
    NoFog = false,

    FastScan = false,

    WeaponMods = {
        NoRecoil = false,
        Firemodes = false
    }
}

---------------------------------------------------------------------
-- STORAGE
---------------------------------------------------------------------
local NPCs = {}
local TrackedParts = {}
local OriginalSizes = {}

---------------------------------------------------------------------
-- COLORS
---------------------------------------------------------------------
local Colors = {
    Zombie = Color3.fromRGB(255,0,0),
    Male = Color3.fromRGB(0,255,0),
    Hitbox = Color3.fromRGB(255,0,0)
}

---------------------------------------------------------------------
-- FOV DRAW
---------------------------------------------------------------------
local FOVCircle
pcall(function()
    if Drawing.new then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Filled = false
        FOVCircle.Thickness = 1.5
        FOVCircle.Color = Color3.new(1,1,1)
    end
